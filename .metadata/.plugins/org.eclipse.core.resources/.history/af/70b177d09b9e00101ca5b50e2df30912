package com.training.basics;

public class Example {
	public static void main(String[] args) {
		int x = 100;
		// upcasting
		long y = x * 2;
		double z = x + y;
		System.out.println(x + " " + y + " " + z);

		double g = 102.3;
		// downcasting
		float s = (float) g;
		long v = (long) (s + g);
		int a = (int) v;
		
		System.out.println(s + " " + v + " " + a);
		
		
	}

}
